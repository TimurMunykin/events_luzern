# Imported by the application's normal Caddyfile, only in the staging container.
header {
  X-Robots-Tag "noindex, nofollow"
  Referrer-Policy "no-referrer"
  # Keep staging visits out of production analytics.
  Content-Security-Policy "connect-src 'self'; script-src 'self' 'unsafe-inline'; frame-src 'self'; worker-src 'self' blob:"
}
# API authentication belongs to PocketBase (Authorization carries its token).
# Public booking/ticket APIs remain public, exactly as in the application.
@preview not path /api/*
basic_auth @preview {
  preview {$STAGING_PASSWORD_HASH}
}
redir /mail /mail/ 302
handle /mail/* {
  reverse_proxy mailpit:8025
}
