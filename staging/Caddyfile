# Imported by the application's normal Caddyfile, only in the staging container.
header {
  X-Robots-Tag "noindex, nofollow"
  Referrer-Policy "no-referrer"
  # Keep staging visits out of production analytics.
  Content-Security-Policy "connect-src 'self'; script-src 'self' 'unsafe-inline'; frame-src 'self'; worker-src 'self' blob:"
}
# The public site opens normally; private pages use the existing login.
redir /mail /mail/ 302
handle /mail/* {
  forward_auth pocketbase:8090 {
    uri /pb-gate
  }
  reverse_proxy mailpit:8025
}
