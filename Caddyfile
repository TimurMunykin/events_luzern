{$SITE_DOMAIN} {
	encode zstd gzip

	handle /api/* {
		reverse_proxy pocketbase:8090
	}

	handle /_ {
		reverse_proxy pocketbase:8090
	}

	handle /_/* {
		reverse_proxy pocketbase:8090
	}

	@staticAssets path /prototypes/assets/*
	header @staticAssets Cache-Control "public, max-age=31536000, immutable"

	handle {
		root * /srv/site
		try_files {path} {path}/ /index.html
		file_server
	}
}
