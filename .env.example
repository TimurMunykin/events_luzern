# Local defaults.
# Copy to .env and override on the VPS.
SITE_DOMAIN=:80
HTTP_PORT=8080
HTTPS_PORT=8443

# Keep PocketBase pinned so local and production behave the same.
PB_VERSION=0.35.0

# Optional. If set and SMTP is configured in PocketBase settings,
# every new request will also send an email notification.
REQUEST_NOTIFY_TO=

# Checkout stays closed until the live payment setup and guest import are ready.
# See docs/DEPLOYMENT.md. Use staging/compose.yml for Sandbox payments.
APP_ENV=production
CHECKOUT_ENABLED=false
CHECKOUT_ORIGIN=https://events-luzern.ch
CHECKOUT_NOTIFY_TO=info@events-luzern.ch
STRIPE_MODE=live
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
TICKET_PAGE_FILE=ticket-v22d.html
